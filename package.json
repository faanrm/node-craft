{
  "name": "@krakennn/node-craft",
  "description": "NodeCraft — CLI and programmatic Node.js project scaffolding tool",
  "main": "dist/bin/node-craft.js",
  "version": "0.4.2",
  "bin": {
    "node-craft": "dist/bin/node-craft.js"
  },
  "exports": {
    ".": {
      "types": "./dist/bin/node-craft.d.ts",
      "import": "./dist/bin/node-craft.js",
      "require": "./dist/bin/node-craft.js",
      "default": "./dist/bin/node-craft.js"
    },
    "./lib": {
      "types": "./dist/src/lib.d.ts",
      "import": "./dist/src/lib.js",
      "require": "./dist/src/lib.js",
      "default": "./dist/src/lib.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "start": "nodemon",
    "build": "tsc --build --force && copyfiles --up 1 \"src/**/*.{ejs,html,json,yaml,jpg,png}\" dist/src",
    "generate": "prisma generate",
    "migrate": "prisma db push",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@krakennn/node-craft": "^0.4.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.5.2",
    "prisma": "^5.2.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.6.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^4.1.3"
  },
  "author": {
    "name": "krakennn"
  },
  "license": "ISC"
}
