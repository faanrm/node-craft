<% const enumNames = model.fields.filter(f => f.enumName).map(f => f.enumName); %>
<% if (enumNames.length > 0) { %>
<% enumNames.forEach(enumName => { %>import { <%= enumName %> } from '../enums/<%= enumName %>';
<% }); %>
<% } %>

/**
 * Standard interface for <%= model.name %>
 */
export interface I<%= model.name %> {
  id: string | any;
<% model.fields.forEach(field => { %>
  <%= field.name %><%= field.isOptional ? '?' : '' %>: <%= getTSType(field) %>;
<% }) %>
  createdAt: Date;
  updatedAt: Date;
}

/**
 * Input for creating a <%= model.name %>
 */
export type Create<%= model.name %>Input = Omit<I<%= model.name %>, 'id' | 'createdAt' | 'updatedAt'>;

/**
 * Input for updating a <%= model.name %>
 */
export type Update<%= model.name %>Input = Partial<Create<%= model.name %>Input>;