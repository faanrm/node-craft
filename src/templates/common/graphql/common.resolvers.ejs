import { GraphQLScalarType, Kind } from 'graphql';

export interface GraphQLContext {
  user?: {
    id: string;
    email: string;
    [key: string]: any;
  };
}

const JSONScalar = new GraphQLScalarType({
  name: 'JSON',
  description: 'Custom JSON scalar type',
  parseValue(value: any) { return value; },
  serialize(value: any) { return value; },
  parseLiteral(ast: any) {
    if (ast.kind === Kind.OBJECT) {
      const value = Object.create(null);
      ast.fields.forEach(field => {
        value[field.name.value] = field.value.kind === Kind.OBJECT ? JSON.parse(JSON.stringify(field.value)) : (field.value as any).value;
      });
      return value;
    }
    return null;
  }
});

export const commonResolvers = {
  JSON: JSONScalar,
  Query: {
    _empty: () => 'Node Craft API'
  },
  Mutation: {
    _empty: () => 'Node Craft API'
  }
};
